# ── ShareBajar configuration ─────────────────────────────────────────────
# Every variable is optional. Without a value the related feature is shown
# as "not configured" in the UI — nothing is faked.

# AI market intelligence (ShareBajar Intelligence). Server-side only.
ANTHROPIC_API_KEY=

# Market data needs NO API keys: CoinLore (rankings, market cap, supply),
# Binance public market data (live prices, candles, order books) and
# on-chain data read directly from each network.

# Optional: override public RPC nodes used for live network stats
# (block height, gas, TPS). Defaults are publicnode.com endpoints.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_BSC=
RPC_URL_POLYGON=
RPC_URL_ARBITRUM=
RPC_URL_AVALANCHE=
RPC_URL_OPTIMISM=
RPC_URL_SOLANA=

# Solana JSON-RPC used in the browser for balances, simulation and
# transaction status. Use a dedicated provider in production
# (Helius, Triton, QuickNode...). The public endpoint is heavily rate-limited.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Market-data mirrors. Binance's public market-data hosts are used because
# api.binance.com is geo-restricted in some regions.
BINANCE_REST_URL=https://data-api.binance.vision
NEXT_PUBLIC_BINANCE_WS_URL=wss://data-stream.binance.vision

# ── Treasury (noncustodial platform revenue) ─────────────────────────────
# PostgreSQL connection string (required in production; local dev uses an
# embedded Postgres under .data/).
DATABASE_URL=
# 32-byte key (64 hex chars) for encrypting treasury config + integrity seals.
# Generate: openssl rand -hex 32
TREASURY_ENCRYPTION_KEY=
# Comma-separated admin wallet addresses that bootstrap the "owner" role.
TREASURY_OWNERS=
# Wallet signatures (from different admins, requester included) required for
# sensitive changes. Keep 2+ in production.
TREASURY_REQUIRED_APPROVALS=2
# Admin actions require a wallet sign-in within this many minutes.
TREASURY_FRESH_AUTH_MINUTES=30
# Platform fee (bps) and hard cap. Provider rules still apply
# (Jupiter referral 50–255 bps; 0x up to 1000 bps).
PLATFORM_FEE_BPS=30
TREASURY_MAX_FEE_BPS=100
# Slack/Discord-compatible webhook for treasury alerts.
TREASURY_ALERT_WEBHOOK_URL=
# Secret for the scheduled indexer (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Swap providers
JUPITER_API_KEY=
ZEROX_API_KEY=
# Server-side Solana RPC used by the treasury indexer (dedicated provider recommended).
SOLANA_RPC_URL=
# ── BAJAR Wallet & cross-chain swaps (docs/WALLET.md) ──
# LI.FI integrator registered at portal.li.fi — required for the cross-chain fee.
LIFI_INTEGRATOR=
LIFI_API_KEY=
# Cross-chain fee in bps (50 = 0.50%), replaces the swap fee on LI.FI routes.
CROSS_CHAIN_FEE_BPS=50
# mempool.space-compatible API for Bitcoin balances, UTXOs, fees and broadcast.
MEMPOOL_API_URL=https://mempool.space/api
# Token launch fee (USDC). Disclosed; collected only once on-platform token creation exists.
TOKEN_LAUNCH_FEE_USDC=0
