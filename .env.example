# ── ShareBajar configuration ─────────────────────────────────────────────
# Every variable is optional. Without a value the related feature is shown
# as "not configured" in the UI — nothing is faked.

# AI market intelligence (ShareBajar Intelligence). Server-side only.
ANTHROPIC_API_KEY=

# Optional CoinGecko key (Demo or Pro). Raises rate limits.
COINGECKO_API_KEY=
# Set to "pro" if the key above is a Pro key (uses pro-api.coingecko.com).
COINGECKO_PLAN=demo

# Solana JSON-RPC used in the browser for balances, simulation and
# transaction status. Use a dedicated provider in production
# (Helius, Triton, QuickNode...). The public endpoint is heavily rate-limited.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Market-data mirrors. Binance's public market-data hosts are used because
# api.binance.com is geo-restricted in some regions.
BINANCE_REST_URL=https://data-api.binance.vision
NEXT_PUBLIC_BINANCE_WS_URL=wss://data-stream.binance.vision
